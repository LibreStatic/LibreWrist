{
  "name": "alarm",
  "description": "Fork of the watch Alarm app (AlarmWatch 1.3.05.9) that receives phone alarms from the SHM bridge over direct intents instead of the GMS Data Layer. No launcher icon, own label.",
  "families": {
    "alarm-watch": [
      "alarm-verify-symbols",
      "alarm-rebrand-manifest",
      "alarm-rebrand-code",
      "alarm-permissions-prune",
      "alarm-notification-permissions",
      "alarm-queries-libs",
      "alarm-components-prune",
      "alarm-provider-open",
      "alarm-link-components",
      "alarm-appfunctions-drop",
      "alarm-semgesture-skip",
      "alarm-gms-observer-drop",
      "alarm-service-stop-on-destroy",
      "alarm-force-sound-vibrate",
      "alarm-link-send",
      "alarm-hide-launcher",
      "alarm-relabel"
    ]
  },
  "inject": {
    "alarm-watch": ["alarm-fork"]
  }
}
