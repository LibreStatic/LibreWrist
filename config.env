# Shared configuration for every build. Read from bash (`source config.env`) and from
# Python (scripts/lib/config.py evaluates it with bash, so there is a single source).
# Any variable can be overridden from the environment: PKG_PREFIX=com.example ./build.sh

# Package prefix for our own apps and classes (bridge, ECG adapter, overrides...).
# In the source tree the prefix appears as the placeholder `shminterop`; builds rewrite it
# to this value (scripts/lib/stage_prefix.py). Example: com.example
PKG_PREFIX="${PKG_PREFIX:-shminterop}"

# Android SDK
ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
BUILD_TOOLS_VERSION="${BUILD_TOOLS_VERSION:-36.0.0}"
PLATFORM_API="${PLATFORM_API:-36}"

# Third-party dependencies (downloaded by scripts/fetch_deps.sh; not versioned)
APKTOOL_JAR="${APKTOOL_JAR:-$SHM_ROOT/third_party/apktool_3.0.3.jar}"
APKTOOL_HEAP="${APKTOOL_HEAP:--Xmx4g}"

# Official input APKs (provided by the owner; see apks/README.md and apks/SHA256SUMS)
APKS_DIR="${APKS_DIR:-$SHM_ROOT/apks}"

# Keys shared by every checkout on this machine, outside any repository (0700). Back it up: losing
# apk-signing.p12 means installed apps can no longer be upgraded.
OPENSHM_KEYS_DIR="${OPENSHM_KEYS_DIR:-$HOME/.local/share/openshm/keys}"

# Signing key of every built APK (PKCS#12, password in KS_PASS_FILE). scripts/lib/common.sh
# generates both if the keystore does not exist. The patcher app can import the same key.
KEYSTORE="${KEYSTORE:-$OPENSHM_KEYS_DIR/apk-signing.p12}"
KEY_ALIAS="${KEY_ALIAS:-openshm}"
KS_PASS_FILE="${KS_PASS_FILE:-$OPENSHM_KEYS_DIR/apk-signing.pass}"

# Private key that signs catalogue/catalogue.json (ECDSA P-256, PKCS#8 PEM).
# Created once with `scripts/catalogue.py genkey`; the public half is catalogue/catalogue.pub.
CATALOGUE_KEY="${CATALOGUE_KEY:-$OPENSHM_KEYS_DIR/catalogue-ec.pem}"

# SHA-256 of the signing certificate of the patcher app (64 hex chars, colons optional). When set,
# shm-bridge/scripts/build-bridge.sh declares the phone bridge's STATUS permission as
# `signature|knownSigner` with this digest, so the patcher app (signed with another key) can read
# the status provider. Empty = plain `signature`. knownSigner needs API 31+ (ignored below).
# Defaults to the digest written next to the shared patcher keystore (patcher.cert.sha256), if any.
PATCHER_CERT_SHA256="${PATCHER_CERT_SHA256:-$(cat "$OPENSHM_KEYS_DIR/patcher.cert.sha256" 2>/dev/null)}"

# Work and output directories. WORK_DIR must be on disk, never on tmpfs (/tmp, /dev/shm).
WORK_DIR="${WORK_DIR:-$HOME/.cache/shm-interop}"
DIST_DIR="${DIST_DIR:-$SHM_ROOT/dist}"
