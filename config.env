# Shared configuration for every build. Read from bash (`source config.env`) and from
# Python (scripts/lib/config.py evaluates it with bash, so there is a single source).
# Any variable can be overridden from the environment: PKG_PREFIX=com.example ./build.sh

# Package prefix for our own apps and classes (bridge, ECG adapter, overrides...).
# In the source tree the prefix appears as the placeholder `shminterop`; builds rewrite it
# to this value (scripts/lib/stage_prefix.py). Example: com.example
PKG_PREFIX="${PKG_PREFIX:-shminterop}"

# Android SDK
ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
BUILD_TOOLS_VERSION="${BUILD_TOOLS_VERSION:-36.0.0}"
PLATFORM_API="${PLATFORM_API:-36}"

# Third-party dependencies (downloaded by scripts/fetch_deps.sh; not versioned)
APKTOOL_JAR="${APKTOOL_JAR:-$SHM_ROOT/third_party/apktool_3.0.3.jar}"
APKTOOL_HEAP="${APKTOOL_HEAP:--Xmx4g}"
PSW_AAR="${PSW_AAR:-$SHM_ROOT/third_party/play-services-wearable-19.0.0.aar}"

# Official input APKs (provided by the owner; see apks/README.md and apks/SHA256SUMS)
APKS_DIR="${APKS_DIR:-$SHM_ROOT/apks}"

# Local signing key. scripts/lib/common.sh generates the keystore if it does not exist.
KEYSTORE="${KEYSTORE:-$SHM_ROOT/keys/local.keystore}"
KEY_ALIAS="${KEY_ALIAS:-local}"
KS_PASS="${KS_PASS:-changeit}"

# Private key that signs catalogue/catalogue.json (ECDSA P-256, PKCS#8 PEM; keys/ is git-ignored).
# Created once with `scripts/catalogue.py genkey`; the public half is catalogue/catalogue.pub.
CATALOGUE_KEY="${CATALOGUE_KEY:-$SHM_ROOT/keys/catalogue-ec.pem}"

# Work and output directories. WORK_DIR must be on disk, never on tmpfs (/tmp, /dev/shm).
WORK_DIR="${WORK_DIR:-$HOME/.cache/shm-interop}"
DIST_DIR="${DIST_DIR:-$SHM_ROOT/dist}"
