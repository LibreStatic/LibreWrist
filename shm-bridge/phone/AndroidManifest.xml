<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="shminterop.shmbridge.phone"
    android:versionCode="9" android:versionName="1.8">

    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- /__bridge__/ channel (CommsService, BridgeNotificationListener) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"/>
    <!-- BAL exemption for notif/open and alarm/*: appops set SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>

    <!-- Read permission of StatusProvider. Plain `signature` here; scripts/build-bridge.sh rewrites it
         to `signature|knownSigner` + android:knownCerts when PATCHER_CERT_SHA256 is set (the
         patcher app is signed with a different key; knownSigner is ignored below API 31). -->
    <permission android:name="shminterop.shmbridge.permission.STATUS"
        android:protectionLevel="signature"/>

    <application android:label="SHM Bridge" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
        <!-- No launcher entry on purpose: the bridge runs headless. Still startable with
             `am start -n <pkg>/.MainActivity` (it starts the link service). -->
        <activity android:name=".MainActivity" android:exported="true"/>
        <!-- /__bridge__/ communications channel (docs/architecture.md).
             Exported for the shell only (DUMP permission): am start-foreground-service, user 0,
             shminterop.shmbridge.phone/.CommsService -->
        <service android:name=".CommsService" android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Companion link to the owner's smartwatch over a direct Bluetooth link (notifications, alarms, call state)"/>
        </service>
        <service android:name=".BridgeNotificationListener" android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- Read-only bridge status for the patcher app (no side effects). Access is checked in
             StatusProvider against the STATUS permission and the PATCHER_CERT meta-data, not with
             android:readPermission: the patcher app cannot request a permission whose name
             carries a per-user prefix it only learns at build time.
             PATCHER_CERT is the SHA-256 (64 lowercase hex characters) of the patcher app's signing
             certificate. Empty here: scripts/build-bridge.sh and the patcher engine fill it in
             when a digest is configured. Empty means no app outside the bridge's own signature
             is let in. -->
        <provider android:name=".StatusProvider"
            android:authorities="shminterop.shmbridge.phone.status"
            android:exported="true">
            <meta-data android:name="shminterop.shmbridge.PATCHER_CERT" android:value=""/>
        </provider>
        <receiver android:name=".CommsBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="shminterop.shmbridge.START"/>
            </intent-filter>
        </receiver>
        <receiver android:name=".CommsDebugReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="shminterop.shmbridge.DEBUG_SEND"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
