<?xml version="1.0" encoding="utf-8"?>
<!-- Watch face with a pulse line (same glyph as the patcher app) plus a "link" badge at the
     bottom-right of the safe zone. The clip leaves a ring-shaped gap around the badge, so the
     same drawable works as the coloured foreground and as the single-colour monochrome layer;
     the link glyph is a hole in the badge (the background shows through). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group>
        <!-- Whole canvas minus the ring disc (opposite winding makes the hole). -->
        <clip-path android:pathData="M0,0 H108 V108 H0 Z M83.5,68 a15.5,15.5 0 1,0 -31,0 a15.5,15.5 0 1,0 31,0 Z" />
        <path
            android:fillColor="#00000000"
            android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5" />
        <path
            android:fillColor="#00000000"
            android:pathData="M36,52 L44,52 L48,42 L53,59 L56,52"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
    </group>
    <!-- Badge: disc centred at (68,68), radius 13.5, with the Material "link" glyph cut out. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateX="56"
        android:translateY="56">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M-3.88,12 a15.88,15.88 0 1,0 31.76,0 a15.88,15.88 0 1,0 -31.76,0 Z M3.9,12c0,-1.71 1.39,-3.1 3.1,-3.1h4V7H7c-2.76,0 -5,2.24 -5,5s2.24,5 5,5h4v-1.9H7c-1.71,0 -3.1,-1.39 -3.1,-3.1zM8,13h8v-2H8v2zM17,7h-4v1.9h4c1.71,0 3.1,1.39 3.1,3.1s-1.39,3.1 -3.1,3.1h-4V17h4c2.76,0 5,-2.24 5,-5s-2.24,-5 -5,-5z" />
    </group>
</vector>
