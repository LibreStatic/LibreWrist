<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Launcher apps are visible, so the Samsung Health Monitor copy this app installs can be opened
      after its install. The bridge app is visible because this app is its installer.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PatcherApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenSHMPatcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Receives the platform installer's result for the phone install. -->
        <receiver
            android:name=".device.PhoneInstallReceiver"
            android:exported="false" />
        <!-- Keeps the phone's own Wireless debugging session alive while the user pairs it in Developer options. -->
        <service
            android:name=".device.SelfAdbService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pairing this phone with its own Wireless debugging so the user's own apps can be granted their access" />
        </service>
        <!-- Builds the patched APKs on the device; no other foreground service type fits. -->
        <service
            android:name=".build.BuildService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-device APK build: patching, rebuilding and signing the user's own copies of the apps" />
        </service>
    </application>
</manifest>
