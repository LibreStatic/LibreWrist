<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The periodic update check is persisted across reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The reinstall fallback removes a copy signed with another key, only after the user confirmed it. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Launcher apps are visible, so the Samsung Health Monitor copy this app installs can be opened
      after its install. Being its installer does not make the bridge visible (visibility only goes
      from the installed app to its installer), and it has no launcher entry; its package name has
      the user's random prefix, so it is matched through its notification listener instead. Without
      it the permission, app-op and battery reads of the install screen report "not granted".
    -->
    <queries>
        <!--
          Galaxy Wearable and its watch plugin: read-only presence checks on the "Is your watch
          paired?" screen, and launching Galaxy Wearable from it.
        -->
        <package android:name="com.samsung.android.app.watchmanager" />
        <!-- One watch plugin per model family; keep in sync with WATCH_PLUGIN_PACKAGES. -->
        <package android:name="com.samsung.android.waterplugin" />
        <package android:name="com.samsung.android.heartplugin" />
        <package android:name="com.samsung.wearable.watch6plugin" />
        <package android:name="com.samsung.wearable.watch7plugin" />
        <package android:name="com.samsung.wearable.watchuniteplugin" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.service.notification.NotificationListenerService" />
        </intent>
        <!-- The interactive guide reads Settings' own labels, so it matches them in the user's language and skin. -->
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:name=".PatcherApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenSHMPatcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The periodic (12 h) check for a newer patcher build; scheduled only while the user allows it. -->
        <service
            android:name=".update.AppUpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Receives the platform installer's result for the phone install. -->
        <receiver
            android:name=".device.PhoneInstallReceiver"
            android:exported="false" />
        <!-- Keeps the phone's own Wireless debugging session alive while the user pairs it in Developer options. -->
        <service
            android:name=".device.SelfAdbService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pairing this phone with its own Wireless debugging so the user's own apps can be granted their access" />
        </service>
        <!-- Builds the patched APKs on the device; no other foreground service type fits. -->
        <service
            android:name=".build.BuildService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-device APK build: patching, rebuilding and signing the user's own copies of the apps" />
        </service>
        <!-- Streams the watch's and the phone's logcat (filtered to the patched apps) in the background. -->
        <service
            android:name=".device.DeviceLogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Streams diagnostic logs from the user's own watch and phone over ADB for troubleshooting" />
        </service>
        <!-- Tic, the interactive guide: points at (and taps the safe) setup steps in Settings. Inert until the app starts a guided hand-off. -->
        <service
            android:name=".device.guide.GuideAccessibilityService"
            android:exported="true"
            android:label="@string/automation_guide_title"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guide_accessibility" />
        </service>
    </application>
</manifest>
