    <!-- Install -->
    <string name="install_phone_title">安裝到這支手機</string>
    <string name="install_phone_intro">Android 會要求你確認每次安裝。應用程式所需的存取權限會在之後檢查；缺少的權限需要你在**設定**中開啟。</string>
