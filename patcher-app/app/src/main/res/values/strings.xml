    <!-- Welcome -->
    <string name="welcome_title">Your apps, your watch, your way</string>
    <string name="welcome_promise_download">You get the official apps yourself; nothing is bundled here.</string>
    <string name="welcome_promise_patch">Patches make Samsung Health Monitor work on a phone that is not a Samsung and sit next to the stock watch app.</string>
    <string name="welcome_promise_undo">Every change can be undone, and the stock apps stay put.</string>
    <string name="welcome_get_started">Get started</string>
    <string name="welcome_what_changes">What will change on my devices?</string>
    <string name="changes_title">What will change</string>
    <string name="changes_intro">Only these apps are installed, and only these settings are touched. Nothing is erased.</string>
    <string name="changes_installs">Installed</string>
    <string name="changes_grants">Allowed after installing</string>
    <string name="changes_disables">Can be turned off</string>

