    <!-- Patch descriptions (titles come from the catalogue) -->
    <string name="patch_generic_manufacturer_check">Accepts a phone that is not made by Samsung.</string>
    <string name="patch_generic_vendor_check">Accepts a phone without the Samsung SDK.</string>
    <string name="patch_shm_min_age_22_to_16">Lowers the minimum age from 22 to 16.</string>
    <string name="patch_shm_supported_type_ordinals">Treats every region as supported.</string>
    <string name="patch_shm_region_supportedtype">Lets the region check pass.</string>
    <string name="patch_shm_region_countrylist">Accepts any country in the supported list.</string>
    <string name="patch_shm_root_packagevalidator">Skips the vendor certificate validation.</string>
    <string name="patch_shm_force_update_response">Ignores a failed or forced update answer.</string>
    <string name="patch_shm_force_update_pref">Ignores the stored forced-update flag.</string>
    <string name="patch_shm_main_gates">Skips the start-up checks that block other phones.</string>
    <string name="patch_shm_setup_network_gate">Skips the SIM and region gate during setup.</string>
    <string name="patch_shm_sleep_apnea_support">Reports sleep apnea as supported.</string>
    <string name="patch_phone_rebrand_gms">Gives the phone app the same package and key as the watch app so the two can exchange data.</string>
    <string name="patch_watch_rebrand_coexist">Renames the watch app so it sits next to the stock one.</string>
    <string name="patch_watch_queries_health_service">Lets the watch app see the health service.</string>
    <string name="patch_watch_companion_vendor">Accepts any companion phone brand.</string>
    <string name="patch_watch_alarm_system_app">Schedules exact alarms without system privileges.</string>
    <string name="patch_watch_mobile_installed">Reports the phone app as installed.</string>
    <string name="patch_watch_ecg_sensor_adapter">Reads the ECG sensor through the Health Tracking service.</string>
    <string name="patch_watch_apnea_country">Skips the apnea country check.</string>
    <string name="patch_watch_apnea_reeval_not_supported">Re-checks apnea support that was stored as unsupported.</string>
    <string name="patch_watch_mod">Adds the module that talks to the Health Tracking service.</string>
    <string name="patch_alarm_verify_symbols">Checks the alarm app has the parts the link needs.</string>
    <string name="patch_alarm_rebrand_manifest">Renames the alarm app so it installs next to the stock one.</string>
    <string name="patch_alarm_rebrand_code">Updates the alarm app\'s code to the new name.</string>
    <string name="patch_alarm_permissions_prune">Drops permissions only system apps can hold.</string>
    <string name="patch_alarm_notification_permissions">Adds notification and full-screen alarm permissions.</string>
    <string name="patch_alarm_queries_libs">Removes lookups and libraries the fork does not need.</string>
    <string name="patch_alarm_components_prune">Removes vendor components the fork does not need.</string>
    <string name="patch_alarm_provider_open">Opens the alarm data to the fork.</string>
    <string name="patch_alarm_link_components">Adds the receiver for alarms sent from the phone.</string>
    <string name="patch_alarm_appfunctions_drop">Removes an unused vendor feature tree.</string>
    <string name="patch_alarm_semgesture_skip">Skips the vendor gesture manager.</string>
    <string name="patch_alarm_gms_observer_drop">Stops the alarm from ending early.</string>
    <string name="patch_alarm_service_stop_on_destroy">Makes sure sound and vibration always stop.</string>
    <string name="patch_alarm_force_sound_vibrate">Always rings and vibrates.</string>
    <string name="patch_alarm_link_send">Sends alarm changes to the phone.</string>
    <string name="patch_alarm_hide_launcher">Hides the extra launcher icon.</string>
    <string name="patch_alarm_relabel">Names the fork \"Phone alarms\".</string>
    <string name="patch_alarm_fork">Adds the module that links alarms to the phone.</string>
    <string name="output_shm_phone">Samsung Health Monitor (patched)</string>
    <string name="output_shm_watch">Samsung Health Monitor for Wear OS (patched)</string>
    <string name="output_bridge_watch">Bridge for the watch</string>
    <string name="output_alarm_fork">Phone alarms on the watch</string>
