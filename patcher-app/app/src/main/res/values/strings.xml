    <string name="profile_title">Which watch do you have?</string>
    <string name="profile_intro">This decides which official apps you need to bring.</string>
    <string name="profile_wear5_title">Wear OS 5 or newer</string>
    <string name="profile_wear5_summary">Health Monitor plus phone alarms on the watch.</string>
    <string name="profile_wear5_apps">3 official apps</string>
    <string name="profile_wear3_title">Wear OS 3 or 4</string>
    <string name="profile_wear3_summary">Health Monitor only. The alarm app needs Android 14 on the watch.</string>
    <string name="profile_wear3_apps">2 official apps</string>

